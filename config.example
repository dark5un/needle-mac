# endpoint of the primary (local) engine: Strata, llama.cpp, Ollama, ...
endpoint          = http://127.0.0.1:8080/v1
model             = qwen3.8-flash-next-iq3_xxs

# secondary OpenAI-compatible endpoint, used only when the primary fails
# (server down, HTTP error, empty result). Leave unset (or comment these
# lines out) for local-only. Example: any OpenAI-compatible server.
#fallback_endpoint = http://other-host.local:11434/v1
#fallback_model    = some-model
# key for the fallback (env NEEDLE_FALLBACK_API_KEY wins if both are set);
# the file is env-format with one line: API_KEY=***
#fallback_key_file = ~/.config/needle-mac/engine.env
#fallback_key_var  = API_KEY

# global hotkey that opens the action palette
hotkey            = ctrl+opt+o
# same palette, but the result goes only to the clipboard (no paste injected)
hotkey_clipboard  = ctrl+opt+i

# combos used for capture (copy) and delivery (paste)
copy_combo        = cmd+c
paste_combo       = cmd+v

max_tokens        = 4096
timeout           = 120

# --- Hermes agent engine ("take to hermes") ------------------------------
# The hermes / hermes-ask actions run the Hermes Agent CLI as a subprocess
# in LOCKDOWN mode: Hermes' own config.yaml is NOT loaded (--ignore-user-
# config), so MCP servers, plugins and hosted-provider fallbacks do not
# exist for these calls. Routing is explicit and pinned per call:
#   provider=custom, base_url below (default: endpoint), model (default:
#   model), api key via the existing key_file/NEEDLE_API_KEY mechanism.
# Toolsets are fixed by needle-mac, never by selection text: "hermes" may
# use web_search/web_extract for information retrieval ONLY; "hermes-ask"
# has no tools at all. No shell, no files, no subagents, no MCP — ever.
hermes_command      = hermes              # binary name or path; ~ is expanded
hermes_session      = needle-mac          # named Hermes session, kept across actions
hermes_timeout      = 600                 # seconds; wall-clock kill switch
# hermes_base_url     = http://127.0.0.1:8080/v1   # default: the endpoint above
# hermes_model        = some-model                 # default: the model above;
#        pick via `needle-mac hermes-models` or the menu's Discover item.
#        (changing it applies to the next NEW hermes_session)
# hermes_max_turns    = 10                # tool-loop cap (web lookups)
# Opt in to falling back to the HTTP engine above when hermes is down
# (off by default — sending the text elsewhere is a privacy surprise):
# hermes_fallback     = engine
